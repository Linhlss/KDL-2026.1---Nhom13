<mxCell id="n4" parent="1" vertex="1" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#235eaa&quot;&gt;&lt;b&gt;DIMENSION · 3 vai trò thời gian&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:21px&quot; color=&quot;#16273d&quot;&gt;&lt;b&gt;dim_month&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#52647a&quot;&gt;PK month_key integer (0 = Unknown)&lt;br&gt;yyyymm · calendar_year · calendar_month&lt;br&gt;Vai trò: snapshot · report · effective&lt;br&gt;Hierarchy: calendar_year → calendar_month&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=10;fillColor=#eef4fc;strokeColor=#235eaa;strokeWidth=2;fontFamily=Arial;"><mxGeometry x="780" y="200" width="740" height="215" as="geometry"/></mxCell>
<mxCell id="n5" parent="1" vertex="1" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#235eaa&quot;&gt;&lt;b&gt;DIMENSION · chỉ cho Fact sự kiện&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:21px&quot; color=&quot;#16273d&quot;&gt;&lt;b&gt;dim_action_category&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#52647a&quot;&gt;PK category_key bigint (0 = Unknown)&lt;br&gt;month_key FK · family · category_code&lt;br&gt;category_label · provenance · verification_status&lt;br&gt;family: accessions / separations / unknown&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=10;fillColor=#fdf3e6;strokeColor=#c0680f;strokeWidth=2;fontFamily=Arial;"><mxGeometry x="1640" y="200" width="600" height="215" as="geometry"/></mxCell>
<mxCell id="n6" parent="1" vertex="1" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#235eaa&quot;&gt;&lt;b&gt;FACT · snapshot (bán cộng dồn)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:21px&quot; color=&quot;#16273d&quot;&gt;&lt;b&gt;fact_employment_snapshot&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#52647a&quot;&gt;Grain: 1 dòng nguồn Employment&lt;br&gt;PK (file_id, source_row_ordinal)&lt;br&gt;snapshot_month_key FK → dim_month  [role: snapshot]&lt;br&gt;report_month_key FK → dim_month  [role: report, truy vết]&lt;br&gt;agency_key FK → dim_agency&lt;br&gt;count_value · agency_lookup_state · dq_flags&lt;br&gt;KPI: K01–K05, K09&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=10;fillColor=#ffffff;strokeColor=#235eaa;strokeWidth=2;fontFamily=Arial;"><mxGeometry x="50" y="600" width="680" height="300" as="geometry"/></mxCell>
<mxCell id="n7" parent="1" vertex="1" value="&lt;font style=&quot;font-size:14px&quot; color=&quot;#235eaa&quot;&gt;&lt;b&gt;FACT · sự kiện (cộng dồn)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:21px&quot; color=&quot;#16273d&quot;&gt;&lt;b&gt;fact_accessions&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#52647a&quot;&gt;Grain: 1 dòng nguồn Accessions&lt;br&gt;PK (file_id, source_row_ordinal)&lt;br&gt;report_month_key FK → dim_month  [role: report, mặc định]&lt;br&gt;effective_month_key FK → dim_month  [role: effective, USERELATIONSHIP]&lt;br&gt;agency_key FK → dim_agency&lt;br&gt;category_key FK → dim_action_category&lt;br&gt;count_value · lookup_state · dq_flags&lt;br&gt;KPI: K06, K08&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=10;fillColor=#ffffff;strokeColor=#1c7c54;strokeWidth=2;fontFamily=Arial;"><mxGeometry x="810" y="600" width="680" height="330" as="geometry"/></mxCell>
