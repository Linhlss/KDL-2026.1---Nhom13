<mxfile host="app.diagrams.net" agent="Nhóm 13" version="24.7.17"><diagram id="page-1" name="Cây nghiệp vụ và các điểm phân tích"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1540" pageHeight="750"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Cây nghiệp vụ và các điểm phân tích" style="text;html=0;fontSize=28;fontFamily=Arial;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="25" width="1470" height="60" as="geometry" /></mxCell><mxCell id="n0" value="Phân tích nhân lực liên bang&#10;&#10;Quy mô · cơ cấu · hành động · biến động" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eefc;strokeColor=#bbc8d7;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1"><mxGeometry x="495" y="140" width="550" height="95" as="geometry" /></mxCell><mxCell id="n1" value="Dữ liệu dùng được?&#10;&#10;A01: nhận file/kỳ/version&#10;A02: chất lượng&#10;A03: mã và quan hệ&#10;TV2, TV3, TV5" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f3ee;strokeColor=#bbc8d7;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1"><mxGeometry x="35" y="310" width="340" height="205" as="geometry" /></mxCell><mxCell id="n2" value="Có bao nhiêu, ở đâu?&#10;&#10;A04: quy mô snapshot&#10;A05: cơ cấu theo nhóm&#10;D1: Employment&#10;TV2 → TV3 → TV4" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0db;strokeColor=#bbc8d7;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1"><mxGeometry x="410" y="310" width="340" height="205" as="geometry" /></mxCell><mxCell id="n3" value="Có những lượt nào?&#10;&#10;A06: tiếp nhận&#10;A07: rời cơ quan&#10;D2: hai họ hành động&#10;TV2 → TV3 → TV4" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eae8fb;strokeColor=#bbc8d7;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1"><mxGeometry x="785" y="310" width="340" height="205" as="geometry" /></mxCell><mxCell id="n4" value="Quy mô đổi thế nào?&#10;&#10;A08: so hai snapshot&#10;D3: nhóm tăng/giảm&#10;Không dùng K08 thay K02&#10;TV1, TV3, TV4" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eae8fb;strokeColor=#bbc8d7;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1"><mxGeometry x="1160" y="310" width="345" height="205" as="geometry" /></mxCell><mxCell id="n5" value="A09 đối soát · A10 nhận xét&#10;&#10;TV5 kiểm độc lập; TV1 và mỗi thành viên giải thích phần mình." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fce8ec;strokeColor=#bbc8d7;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1"><mxGeometry x="410" y="575" width="715" height="90" as="geometry" /></mxCell><mxCell id="e0" style="endArrow=block;html=0;strokeColor=#536479;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="235" as="sourcePoint" /><mxPoint x="205" y="310" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e1" style="endArrow=block;html=0;strokeColor=#536479;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="235" as="sourcePoint" /><mxPoint x="580" y="310" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e2" style="endArrow=block;html=0;strokeColor=#536479;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="235" as="sourcePoint" /><mxPoint x="955" y="310" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e3" style="endArrow=block;html=0;strokeColor=#536479;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="235" as="sourcePoint" /><mxPoint x="1332" y="310" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
