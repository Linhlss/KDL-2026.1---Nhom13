        <mxCell id="errlabel" parent="1" vertex="1" value="Sai checksum / schema / file thiếu / lỗi nạp → FAIL + bảo toàn lượt hợp lệ" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#a64b3a;fontStyle=0;">
