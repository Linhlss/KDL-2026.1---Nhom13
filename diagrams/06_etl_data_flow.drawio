        </mxCell>
        <mxCell id="e45" parent="1" edge="1" source="j04" target="j05" style="edgeStyle=none;strokeColor=#235eaa;strokeWidth=2;endArrow=block;dashed=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e56" parent="1" edge="1" source="j05" target="j06" style="edgeStyle=none;strokeColor=#235eaa;strokeWidth=2;endArrow=block;dashed=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e34label" parent="1" vertex="1" value="Lineage ODS → Fact" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#235eaa;fontStyle=1;">
          <mxGeometry x="1365" y="550" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="audit" parent="1" vertex="1" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#a64b3a&quot;&gt;&lt;b&gt;CHECKPOINT XUYÊN LUỒNG&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot; color=&quot;#16273d&quot;&gt;&lt;b&gt;Audit và nhánh lỗi&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot; color=&quot;#52647a&quot;&gt;audit.load_run ghi SUCCESS / SKIPPED / FAIL theo job, file và run_id.&lt;br&gt;Lỗi rollback dữ liệu theo phạm vi file; audit FAIL được ghi độc lập. audit.dq_issue giữ ngoại lệ có lineage.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=18;spacingLeft=18;fillColor=white;strokeColor=#c4d1e1;strokeWidth=2;fontFamily=Arial;">
