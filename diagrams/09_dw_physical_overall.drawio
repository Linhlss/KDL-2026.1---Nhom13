        <mxCell id="label_review" parent="1" vertex="1" value="&lt;font style=&quot;font-size:15px&quot; color=&quot;#2e7d32&quot;&gt;&lt;b&gt;MỚI 27/11 · TV2 LABEL REVIEW&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:23px&quot; color=&quot;#16273d&quot;&gt;&lt;b&gt;ref.label_review&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot; color=&quot;#52647a&quot;&gt;PK (relation, report_month, code)&lt;br&gt;review_result · proposed_display_label&lt;br&gt;REVIEW + kết quả lành tính → dim_agency&lt;br&gt;verification_status = REVIEWED_TV2&lt;br&gt;HOLD_ORG_SCOPE giữ Unknown&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=18;spacingLeft=18;fillColor=white;strokeColor=#2e7d32;strokeWidth=3;fontFamily=Arial;">
