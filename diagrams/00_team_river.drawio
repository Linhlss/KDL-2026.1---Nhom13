<mxfile host="app.diagrams.net" agent="Nhóm 13" version="24.7.17"><diagram id="page-1" name="Dòng công việc: mỗi người đưa thêm điều gì vào?"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1540" pageHeight="680"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Dòng công việc: mỗi người đưa thêm điều gì vào?" style="text;html=0;fontSize=28;fontFamily=Arial;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="25" width="1470" height="60" as="geometry" /></mxCell><mxCell id="n0" value="TV1 · Đặt câu hỏi&#10;&#10;Cần biết gì?&#10;Số được hiểu ra sao?&#10;Giao: phạm vi, KPI v0&#10;Nhận lại: giới hạn" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8eefc;strokeColor=#bbc8d7;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1"><mxGeometry x="35" y="175" width="255" height="230" as="geometry" /></mxCell><mxCell id="n1" value="TV2 · Hiểu nguồn&#10;&#10;File/cột nào trả lời?&#10;Mã và kỳ nghĩa gì?&#10;Giao: dictionary, ERD&#10;Nêu chỗ chưa kiểm" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e5f3ee;strokeColor=#bbc8d7;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1"><mxGeometry x="335" y="175" width="255" height="230" as="geometry" /></mxCell><mxCell id="n2" value="TV3 · Dẫn dữ liệu&#10;&#10;Nhận và tổ chức&#10;Giữ đúng số&#10;Giao: bảng, log,&#10;Mart và số đối soát" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0db;strokeColor=#bbc8d7;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1"><mxGeometry x="635" y="175" width="255" height="230" as="geometry" /></mxCell><mxCell id="n3" value="TV4 · Cho thấy số&#10;&#10;Mô hình và chỉ số&#10;Bộ lọc, biểu đồ&#10;Giao: D1, D2, D3&#10;Nhãn kỳ và đơn vị" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eae8fb;strokeColor=#bbc8d7;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1"><mxGeometry x="935" y="175" width="255" height="230" as="geometry" /></mxCell><mxCell id="n4" value="Cả nhóm · Giải thích&#10;&#10;Trả lời câu hỏi&#10;Dẫn đúng bằng chứng&#10;Nêu điều chưa biết&#10;Viết phần báo cáo" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f5f9;strokeColor=#bbc8d7;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1"><mxGeometry x="1235" y="175" width="270" height="230" as="geometry" /></mxCell><mxCell id="n5" value="TV5 · Kiểm suốt dòng chảy&#10;&#10;Đếm độc lập → kiểm nạp → kiểm tổng → SQL/DAX → lọc/public; lỗi trả đúng người." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fce8ec;strokeColor=#bbc8d7;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1"><mxGeometry x="335" y="470" width="855" height="110" as="geometry" /></mxCell><mxCell id="e0" style="endArrow=block;html=0;strokeColor=#536479;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="285" as="sourcePoint" /><mxPoint x="335" y="285" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e1" style="endArrow=block;html=0;strokeColor=#536479;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="285" as="sourcePoint" /><mxPoint x="635" y="285" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e2" style="endArrow=block;html=0;strokeColor=#536479;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="285" as="sourcePoint" /><mxPoint x="935" y="285" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e3" style="endArrow=block;html=0;strokeColor=#536479;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="285" as="sourcePoint" /><mxPoint x="1235" y="285" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
